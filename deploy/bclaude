#!/usr/bin/env bash
# bclaude: menjalankan Claude Code di laptop dengan kredensial dari gateway itsvibes di Bima.
# Bima satu-satunya pemilik refresh token; di sini hanya access token yang diterima. Kredensial ditaruh di folder
# sendiri (~/.claude-gw/<sumber>), jadi ~/.claude/.credentials.json laptop tidak pernah dibaca atau ditulis.
#
#   bclaude pair <kode 6 digit>     pasangkan laptop (kode dari `itsvibes-pair` di Bima)
#   bclaude status                  daftar sumber AI dan masa berlaku token
#   bclaude [-s sumber] [-n|-r|-c] [-- argumen claude]
#       -s personal|produk|merapi   pilih sumber (tanpa ini: ditanya)
#       -n sesi baru   -r pilih sesi lama   -c lanjutkan yang terakhir (tanpa ini: ditanya)
set -euo pipefail

CONF="${BCLAUDE_CONF:-$HOME/.config/bclaude}"
GW="${BCLAUDE_GW:-$HOME/.claude-gw}"
REAL="${BCLAUDE_REAL_CLAUDE_DIR:-$HOME/.claude}"
URL="${ITSVIBES_URL:-$(cat "$CONF/url" 2>/dev/null || echo https://itsvibes.anla.my.id)}"
REFRESH_EVERY="${BCLAUDE_REFRESH_SEC:-600}"

die() { echo "bclaude: $*" >&2; exit 1; }
for t in curl jq; do command -v "$t" >/dev/null || die "butuh $t"; done

# api <path>: cetak isi respons; kalau gagal, tampilkan pesan dari server
api() {
  local raw code
  [[ -s "$CONF/token" ]] || die "belum dipasangkan. Di Bima: itsvibes-pair, lalu: bclaude pair <kode>"
  raw=$(curl -sS --max-time 150 -w '\n%{http_code}' -H "Authorization: Bearer $(cat "$CONF/token")" "$URL$1") || die "tidak bisa menghubungi $URL"
  code=${raw##*$'\n'}; raw=${raw%$'\n'*}
  if [[ $code != 200 ]]; then die "gateway menjawab $code: $(jq -r '.error // empty' <<<"$raw" 2>/dev/null || true)"; fi
  printf '%s\n' "$raw"
}

if [[ ${1:-} == pair ]]; then
  [[ -n ${2:-} ]] || die "pakai: bclaude pair <kode 6 digit>"
  umask 077; mkdir -p "$CONF"
  resp=$(curl -sS --max-time 20 -X POST -H 'content-type: application/json' -d "$(jq -n --arg c "$2" --arg n "laptop-bclaude" '{code:$c,name:$n}')" "$URL/api/pair") || die "tidak bisa menghubungi $URL"
  tok=$(jq -r '.token // empty' <<<"$resp"); [[ -n $tok ]] || die "pairing gagal: $(jq -r '.error // "tanpa pesan"' <<<"$resp")"
  printf '%s' "$tok" > "$CONF/token"; printf '%s' "$URL" > "$CONF/url"
  echo "Terpasang. Jalankan: bclaude"; exit 0
fi

list_sources() { api /api/gateway/sources; }

if [[ ${1:-} == status ]]; then
  list_sources | jq -r '.[] | "\(.id)\t\(if .ready then "siap" else "BELUM" end)\t\(.plan // "-")\t\(if .expiresInMin then "\(.expiresInMin) mnt" else "-" end)\t\(.hint)"' | column -t -s $'\t'
  exit 0
fi

source_id="${BCLAUDE_SOURCE:-}"; mode=(); mode_set=0
while [[ $# -gt 0 ]]; do
  case $1 in
    -s) source_id=${2:?-s butuh nama sumber}; shift 2 ;;
    -n) mode=(); mode_set=1; shift ;;
    -r) mode=(--resume); mode_set=1; shift ;;
    -c) mode=(--continue); mode_set=1; shift ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

CLAUDE_REAL=$(command -v claude) || die "claude tidak ditemukan di PATH"

if [[ -z $source_id ]]; then
  srcs=$(list_sources)
  [[ -t 0 ]] || die "pilih sumber dengan -s (personal|produk|merapi)"
  mapfile -t ids < <(jq -r '.[] | select(.ready) | .id' <<<"$srcs")
  ((${#ids[@]})) || die "tidak ada sumber yang siap di Bima"
  echo "Sumber AI:"
  i=1; for id in "${ids[@]}"; do
    printf '  %d) %s\n' "$i" "$(jq -r --arg id "$id" '.[] | select(.id==$id) | "\(.label)  [\(.plan // "gateway")]  \(.hint)"' <<<"$srcs")"; i=$((i+1))
  done
  read -r -p "Pilih [1-${#ids[@]}]: " n; [[ $n =~ ^[0-9]+$ && $n -ge 1 && $n -le ${#ids[@]} ]] || die "pilihan tidak valid"
  source_id=${ids[$((n-1))]}
fi
[[ $source_id =~ ^(personal|produk|merapi)$ ]] || die "sumber harus personal, produk, atau merapi"

if ((!mode_set)) && [[ -t 0 && $# -eq 0 ]]; then
  echo "Sesi:"; echo "  1) Sesi baru"; echo "  2) Lanjutkan, pilih dari daftar"; echo "  3) Lanjutkan yang terakhir"
  read -r -p "Pilih [1-3]: " m
  case $m in 2) mode=(--resume) ;; 3) mode=(--continue) ;; *) mode=() ;; esac
fi

# folder konfigurasi per sumber: hanya login yang terpisah, riwayat sesi dan pengaturan ditautkan ke ~/.claude
DIR="$GW/$source_id"
mkdir -p "$DIR"; chmod 700 "$GW" "$DIR"
if [[ -d $REAL ]]; then
  for p in "$REAL"/*; do
    [[ -e $p ]] || continue
    n=$(basename "$p")
    if [[ ! -e $DIR/$n && ! -L $DIR/$n ]]; then ln -s "$p" "$DIR/$n"; fi
  done
fi
[[ -e $DIR/.claude.json ]] || (umask 077; echo '{"hasCompletedOnboarding":true,"bypassPermissionsModeAccepted":true}' > "$DIR/.claude.json")

write_creds() { # $1 = respons gateway
  local tmp="$DIR/.credentials.json.tmp"
  (umask 077; jq '{claudeAiOauth:{accessToken,expiresAt,scopes,subscriptionType,rateLimitTier}}' <<<"$1" > "$tmp")
  mv -f "$tmp" "$DIR/.credentials.json"
}

unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_OAUTH_REFRESH_TOKEN
export CLAUDE_CONFIG_DIR="$DIR"
resp=$(api "/api/gateway/credentials?source=$source_id")
RPID=""
case $(jq -r .kind <<<"$resp") in
  oauth)
    write_creds "$resp"
    # Sengaja tanpa CLAUDE_CODE_OAUTH_TOKEN: token di env tidak bisa berganti selama proses hidup (terbukti, hanya berlaku
    # sampai habis). Lewat berkas, proses yang sama membaca ulang token di tiap permintaan, jadi sesi bisa berjalan berhari-hari.
    # Token baru ditulis di bawah sebelum yang lama habis (gateway selalu memberi yang masih berlaku minimal 60 menit).
    ( while sleep "$REFRESH_EVERY"; do
        r=$(api "/api/gateway/credentials?source=$source_id" 2>/dev/null) || continue
        if [[ $(jq -r .accessToken <<<"$r") != "$(jq -r .claudeAiOauth.accessToken "$DIR/.credentials.json" 2>/dev/null)" ]]; then write_creds "$r"; fi
      done ) >/dev/null 2>&1 </dev/null &
    RPID=$! ;;
  env)
    while IFS=$'\t' read -r k v; do export "$k=$v"; done < <(jq -r '.env | to_entries[] | [.key, .value] | @tsv' <<<"$resp") ;;
  *) die "jawaban gateway tidak dikenal" ;;
esac
# anak refresher (sleep) ikut dimatikan, kalau tidak ia menahan stdout terminal atau pipa sampai habis
stop_refresher() { if [[ -n $RPID ]]; then pkill -P "$RPID" 2>/dev/null || true; kill "$RPID" 2>/dev/null || true; fi; }
trap stop_refresher EXIT

echo "bclaude: sumber $source_id via $URL" >&2
"$CLAUDE_REAL" --dangerously-skip-permissions "${mode[@]}" "$@"
